# Desenvolvimento local
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=sqlite:///instance/buffet.db
UPLOAD_ROOT=static/uploads
BUSINESS_TIMEZONE=America/Sao_Paulo

# PRODUÇÃO NO RENDER
# Use o Internal Database URL do Render Postgres em DATABASE_URL.
# Exemplo de formato (não copie este valor):
# DATABASE_URL=postgresql://usuario:senha@host-interno/buffet_marquinhos
# UPLOAD_ROOT=/var/data/uploads
#
# O app recusa SQLite efêmero no Render por segurança. Isso evita cadastrar
# eventos/cardápio e perdê-los após um novo deploy ou restart.
